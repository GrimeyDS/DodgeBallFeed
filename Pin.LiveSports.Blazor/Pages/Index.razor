@page "/"

<div class="container">
    <div class="row">
        <img src="../images/banner.jpg" alt="dodgball-banner" id="banner" />
    </div>

    <div class="row">
        <div class="col" id="header">
            <h1>The Dodgeball League</h1>
        </div>
            <Toggle OnChange="ChangeUser"></Toggle>
    </div>
    
        @if (isReporter)
        {
            <Reportage Game="currentGame" Games="games" Teams="teams" OnSave="AddReport"></Reportage>
        }
        else
        {
            <GamesOverview Games="games"></GamesOverview>
        }
</div>
