@page "/"

@inject ITeamService teamService;

<div class="container">
    <div class="row">
        <div class="col" id="header">
            <h1>Dodgeball</h1>
        </div>
            <Toggle OnChange="ChangeUser"></Toggle>
    </div>
    
        @if (isReporter)
        {
            <Reportage Game="currentGame" Games="games" Teams="teams" OnSave="AddReport"></Reportage>
        }
    
        else
        {
            <GamesOverview Teams="teams" Games="games"></GamesOverview>
        }
    
</div>


@code {
    private bool isReporter = false;
    private ReportClient reportClient;
    private List<Game> games = new List<Game>();
    private Team[] teams;
    private GeneralReport reportItem;

    private Game currentGame;

    protected async override Task OnInitializedAsync()
    {
        teams = teamService.GetTeams().ToArray();
        reportClient = new ReportClient();
        reportClient.Configure(OnRemoteReport);
        await reportClient.StartAsync();
    }

    private async Task AddReport(Game game)
    {
        if (games.Where(g => g.Id == game.Id).Count() == 0)
        {
            games.Add(game);
        }
        else
        {
            var oldGame = games.Where(g => g.Id == game.Id).FirstOrDefault();
            oldGame = game;
        }
        await reportClient.AddItemAsync(game);
    }

    private void OnRemoteReport(string json)
    {
        Game game = JsonConvert.DeserializeObject<Game>(json);

        if (games.Where(g => g.Id == game.Id).Count() == 0)
        {
            games.Add(game);
        }
        else
        {
            var oldGame = games.Where(g => g.Id == game.Id).FirstOrDefault();
            oldGame.Reports = game.Reports;
        }
             
        this.StateHasChanged();
    }

    private void ChangeUser()
    {
       isReporter = !isReporter;
    }

    private void ChangeCurrentGame(Game game)
    {
        currentGame = game;
    }
}
