@inherits Pin.LiveSports.Blazor.Components.SubComponents.BaseSelectComponent

<InputSelect class="form-select" id="homeTeam" TValue="Guid" @bind-Value="id" @onmouseup="e => OnSelect.InvokeAsync(id)">
    <option disabled selected>Select a Team</option>
    @foreach (var team in Teams)
    {
        <option value="@team.Id">@team.Name</option>
    }
</InputSelect>

@code {
    [Parameter]
    public Team[] Teams { get; set; }
}
