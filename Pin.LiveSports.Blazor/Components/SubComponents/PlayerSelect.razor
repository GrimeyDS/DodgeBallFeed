

    <InputSelect class="form-select" id="player" TValue="Guid" @bind-Value="playerId" @onmouseup="e => OnSelect.InvokeAsync(playerId)">
        <option disabled selected>Select a Player</option>
        @foreach (var player in Players)
        {
            <option value="@player.Id">@player.FirstName @player.LastName</option>
        }
    </InputSelect>

@code {
    [Parameter]
    public EventCallback<Guid> OnSelect { get; set; }

    [Parameter]
    public Player[] Players { get; set; }

    public Guid playerId;
}
