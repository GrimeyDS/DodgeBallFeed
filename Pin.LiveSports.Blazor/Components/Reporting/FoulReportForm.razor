<div class="row">
    <EditForm Model="@ReportItem" OnValidSubmit="e => OnSave.InvokeAsync(ReportItem)" class="form" >
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <BaseGeneralForm ReportItem="ReportItem"></BaseGeneralForm>

        <div class="row">
            <div class="col-3">
                <label class="col-form-label" for="player">Foul player</label>
                <InputSelect class="form-select" id="homeTeam" TValue="Guid" @bind-Value="ReportItem.PlayerId">
                    @foreach (var player in AllPlayers)
                    {
                        <option value="@player.Id">@player.FirstName @player.LastName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => ReportItem.PlayerId)" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
</div>


@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public FoulReport ReportItem { get; set; }

    [Parameter]
    public Game Game { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Player[] AllPlayers;

    protected override void OnInitialized()
    {
        Player[] HomePlayers = Teams.FirstOrDefault(t => t.Id == Game.HomeTeamId).Players.ToArray();
        Player[] AwayPlayers = Teams.FirstOrDefault(t => t.Id == Game.AwayTeamId).Players.ToArray();
        AllPlayers = [..HomePlayers, ..AwayPlayers];
    }
}
