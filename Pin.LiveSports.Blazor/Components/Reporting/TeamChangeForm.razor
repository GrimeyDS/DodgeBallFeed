<div class="row">
    <EditForm Model="@ReportItem" OnValidSubmit="e => OnSave.InvokeAsync(ReportItem)" class="form">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <BaseGeneralForm ReportItem="ReportItem"></BaseGeneralForm>

        <div class="row">
            <div class="form-check form-switch" id="selection">
                <label class="form-check-label" for="isOut">Out?</label>
                <InputCheckbox class="form-check-input" id="isOut" @bind-Value="ReportItem.IsOut"></InputCheckbox>
                <ValidationMessage For="(() => ReportItem.IsOut)" />
            </div>
            <div class="col-3">
                <label class="col-form-label" for="player">Team</label>
                <InputSelect class="form-select" id="homeTeam" TValue="Guid" @bind-Value="ReportItem.TeamId">
                    <option disabled selected>Select a Team</option>
                    @foreach (var team in Teams)
                    {
                        <option value="@team.Id">@team.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => ReportItem.PlayerId)" />
            </div>
            <div class="col-3">
                @if (ReportItem.TeamId != Guid.Empty)
                {
                    GetPlayers();
                    <label class="col-form-label" for="player">Player</label>
                    <InputSelect class="form-select" id="player" TValue="Guid" @bind-Value="ReportItem.PlayerId">
                        <option disabled selected>Select a Player</option>
                        @foreach (var player in players)
                        {
                            <option value="@player.Id">@player.FirstName @player.LastName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => ReportItem.PlayerId)" />
                }
            </div>

        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public TeamChangeReport ReportItem { get; set; }

    [Parameter]
    public Guid HomeTeamId { get; set; }

    [Parameter]
    public Guid AwayTeamId { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Team[] usableTeams;
    private Player[] players;


    protected override void OnInitialized()
    {
        usableTeams = Teams.Where(t => t.Id == HomeTeamId || t.Id == AwayTeamId).ToArray();
    }

    private void GetPlayers()
    {
        var team = Teams.SingleOrDefault(t => t.Id == ReportItem.TeamId);
        players = team.Players.ToArray();
    }
}
