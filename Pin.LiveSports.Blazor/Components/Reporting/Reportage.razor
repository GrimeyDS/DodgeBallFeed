<Select Data="reportTypes" OnSelect="ChangeReportType" @ref="_selectReport"></Select>

@if (selectedReportType == "Game")
{
    <GameForm Teams="Teams" Game="Game" OnSave="SaveGame"></GameForm>
}
else if (selectedReportType == "Feed")
{
    <Select Data="subReportTypes" OnSelect="ChangeSubReportType" @ref="_selectSubReport"></Select>

    <div class="row" id="selection">
        <div>
            <select @onchange="e => ChangeCurrentGame(e)" class="form-select" aria-label="Default select example">
                <option value="" disabled selected>Select a game</option>
                @foreach (var game in Games)
                {
                    <option value="@game.Id">@game.Name</option>
                }
            </select>
        </div>
    </div>

    @if (selectedSubReportType == "none")
    {
        <div class="row">
            <div class="col">
                <h3>Please select a type of feed</h3>
            </div>
        </div>
    }
    else
    {
        if (selectedGameId == Guid.Empty || Game is null)
        {
            <div class="row">
                <div class="col">
                    <h3>Please select a game</h3>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="form-control col">
                    @switch (selectedSubReportType)
                    {
                        case "General":
                            reportItem = new GeneralReport(Game.GameTime);
                            <GeneralForm ReportItem="reportItem" OnSave="SaveReportItem"></GeneralForm>
                            break;
                        case "Foul":
                            reportItem = new FoulReport(Game.GameTime);
                            <FoulForm Teams="gameTeams" ReportItem="(FoulReport)reportItem" OnSave="SaveReportItem"></FoulForm>
                            break;
                        case "Team Change":
                            reportItem = new TeamChangeReport(Game.GameTime);
                            <TeamChangeForm Game="Game" Teams="gameTeams" ReportItem="(TeamChangeReport)reportItem" OnSave="SaveReportItem"></TeamChangeForm>
                            break;
                        case "Sudden Death":
                            reportItem = new SuddenDeathReport(Game.GameTime);
                            <SuddenDeathForm Game="Game" ReportItem="(SuddenDeathReport)reportItem" OnSave="SaveReportItem"></SuddenDeathForm>
                            break;
                        case "Score":
                            reportItem = new ScoreReport(Game.GameTime);
                            <ScoreForm Game="Game" Teams="gameTeams" ReportItem="(ScoreReport)reportItem" OnSave="SaveReportItem"></ScoreForm>
                            break;
                        case "Win":
                            reportItem = new WinReport(Game.GameTime);
                            <WinForm  Teams="gameTeams" ReportItem="(WinReport)reportItem" OnSave="SaveReportItem"></WinForm>
                            break;
                        default:
                            break;
                    }
                </div>

                <div class="col-4">
                    <GameWidget Game="Game"></GameWidget>
                </div>
            </div>
        }
    }
}
@code {
    [Parameter]
    public EventCallback<Game> OnSave { get; set; }

    [Parameter]
    public Game Game { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    [Parameter]
    public List<Game> Games { get; set; }

    private string[] reportTypes = new string[] { "Game", "Feed" };
    private string[] subReportTypes = new string[] { "General", "Foul", "Team Change", "Sudden Death", "Score", "Win" };
    private string selectedReportType;
    private string selectedSubReportType;
    private Guid selectedGameId;
    private Team[] gameTeams;

    private GeneralReport reportItem;

    private Select _selectReport;
    private Select _selectSubReport;


    private void ChangeReportType(string selectedItem)
    {
        selectedReportType = selectedItem;
        if (selectedReportType == "Game")
            Game = new Game();
    }

    private void ChangeSubReportType(string selectedItem)
    {
        selectedSubReportType = selectedItem;
    }

    private void ChangeCurrentGame(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value.ToString()))
        {
            selectedGameId = Guid.Parse(e.Value.ToString());
            Game = Games.FirstOrDefault(g => g.Id == selectedGameId);
            gameTeams = new Team[] { Game.AwayTeam, Game.HomeTeam };
        }
    }

    private void SaveReportItem(GeneralReport reportItem)
    {
        refresh();
        Game = Games.FirstOrDefault(g => g.Id == selectedGameId);
        Game.GameTime = reportItem.Time;

        var reportTypeName = reportItem.GetType().Name;
        switch  (reportTypeName)
        {
            case nameof(GeneralReport):
                Game.GeneralReports.Add(reportItem);
                break;
            case nameof(FoulReport):
                Game.FoulReports.Add((FoulReport)reportItem);
                break;
            case nameof(TeamChangeReport):
                Game.TeamChangeReports.Add((TeamChangeReport)reportItem);
                CheckPlayerStatus();
                break;
            case nameof(SuddenDeathReport):
                Game.SuddenDeathReports.Add((SuddenDeathReport)reportItem);
                break;
            case nameof(ScoreReport):
                Game.ScoreReports.Add((ScoreReport)reportItem);
                break;
            case nameof(WinReport):
                Game.WinReports.Add((WinReport)reportItem);
                break;
            default:
                break;
        }

        OnSave.InvokeAsync(Game);
    }

    private void SaveGame(Game game)
    {
        refresh();
        var firstReport = new GeneralReport(game.GameTime);
        firstReport.Title = "Game Start";
        firstReport.ReportMessage = "Game has started. Reports will follow";
        game.GeneralReports.Add(firstReport);
        game.GameTime = firstReport.Time;
        OnSave.InvokeAsync(game);
    }

    private void refresh()
    {
        _selectReport.Refresh();
        if (_selectSubReport != null)
            _selectSubReport.Refresh();
        selectedReportType = "none";
        selectedSubReportType = "none";
    }

    private void CheckPlayerStatus()
    {
        //check if all players are out in a team
        foreach (var team in gameTeams)
        {
            if (team.Players.Where(p => p.IsOut == false).Count() == 0)
            {
                var scoreReport = new ScoreReport(Game.GameTime);
                scoreReport.Title = "";
                scoreReport.ReportMessage = "All players are out in " + team.Name;
                scoreReport.ScoredTeam = gameTeams.FirstOrDefault(t => t.Id != team.Id);

                Game.GameTime = scoreReport.Time;

                if (scoreReport.ScoredTeam.Id == Game.HomeTeam.Id)
                    Game.HomeScore++;
                else
                    Game.AwayScore++;

                Game.ScoreReports.Add(scoreReport);

                ResetGame();
            }
        }
    }

    private void ResetGame()
    {
        foreach (var team in gameTeams)
        {
            foreach (var player in team.Players)
            {
                player.IsOut = false;
            }
        }

        var generalReport = new GeneralReport(Game.GameTime);
        generalReport.Title = "Game Reset";
        generalReport.ReportMessage = "All players are returning to the court and the next game will start soon.";
        Game.GameTime = generalReport.Time;

        Game.GeneralReports.Add(generalReport);
    }
}
