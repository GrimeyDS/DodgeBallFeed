<Select Data="reportTypes" OnSelect="ChangeReportType" @ref="_selectReport"></Select>

@if (selectedReportType == "Game")
{
    InitializeNewGame();
    <GameForm Teams="Teams" Game="Game" OnSave="e => OnSave.InvokeAsync(Game)"></GameForm>
}
else if (selectedReportType == "Feed")
{
    <Select Data="subReportTypes" OnSelect="ChangeSubReportType" @ref="_selectSubReport"></Select>

    <div class="row" id="selection">
        <div>
            <select @onchange="e => ChangeCurrentGame(e)" class="form-select" aria-label="Default select example">
                <option value="" disabled selected>Select a game</option>
                @foreach (var game in Games)
                {
                    <option value="@game.Id">@game.Name</option>
                }
            </select>
        </div>
    </div>

    @if (selectedSubReportType == "none")
    {
        <div class="row">
            <div class="col">
                <h3>Please select a type of feed</h3>
            </div>
        </div>
    }
    else if (selectedGameId == Guid.Empty || Game is null)
    {
        <div class="row">
            <div class="col">
                <h3>Please select a game</h3>
            </div>
        </div>
    }
    else
    {

        if (selectedSubReportType == "General")
        {
            <GeneralReportForm ReportItem="reportItem" OnSave="SaveReportItem"></GeneralReportForm>
        }
        else if (selectedSubReportType == "Foul")
        {
            <FoulReportForm Teams="gameTeams" Game="Game" ReportItem="(FoulReport)reportItem" OnSave="SaveReportItem"></FoulReportForm>
        }
        else if (selectedSubReportType == "Team Change")
        {
            <TeamChangeForm Teams="gameTeams" ReportItem="(TeamChangeReport)reportItem" OnSave="SaveReportItem"></TeamChangeForm>
        }
        else if (selectedSubReportType == "Sudden Death")
        {
            <SuddenDeathForm Teams="gameTeams" Game="Game" ReportItem="(SuddenDeathReport)reportItem" OnSave="SaveReportItem"></SuddenDeathForm>
        }
        else if (selectedSubReportType == "Score")
        {
            <ScoreForm Game="Game" Teams="gameTeams" ReportItem="(ScoreReport)reportItem" OnSave="SaveReportItem"></ScoreForm>
        }
    }
}
@code {
    [Parameter]
    public EventCallback<Game> OnSave { get; set; }

    [Parameter]
    public Game Game { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    [Parameter]
    public List<Game> Games { get; set; }

    private string[] reportTypes = new string[] { "Game", "Feed" };
    private string[] subReportTypes = new string[] { "General", "Foul", "Team Change", "Sudden Death", "Score" };
    private string selectedReportType;
    private string selectedSubReportType;
    private Guid selectedGameId;
    private Team[] gameTeams;

    private GeneralReport reportItem;

    private Select _selectReport;
    private Select _selectSubReport;

    private void InitializeNewGame()
    {
        Game = new Game();
        Game.Id = Guid.NewGuid();

    }

    private void ChangeReportType(string selectedItem)
    {
        selectedReportType = selectedItem;
    }

    private void ChangeSubReportType(string selectedItem)
    {
        selectedSubReportType = selectedItem;
        reportItem = selectedSubReportType switch
        {
            "General" => new GeneralReport(),
            "Foul" => new FoulReport(),
            "TeamChange" => new TeamChangeReport(),
            "SuddenDeath" => new SuddenDeathReport(),
            "Score" => new ScoreReport(),
            _ => new(),
        };
    }

    private void ChangeCurrentGame(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value.ToString()))
        {
            selectedGameId = Guid.Parse(e.Value.ToString());
            Game = Games.FirstOrDefault(g => g.Id == selectedGameId);
            gameTeams = Teams.Where(t => t.Id == Game.HomeTeamId || t.Id == Game.AwayTeamId).ToArray();
        }
    }

    private void SaveReportItem(GeneralReport reportItem)
    {
        _selectReport.Refresh();
        _selectSubReport.Refresh();
        selectedReportType = "none";
        selectedSubReportType = "none";

        Game = Games.FirstOrDefault(g => g.Id == selectedGameId);

        var reportTypeName = reportItem.GetType().Name;
        switch  (reportTypeName)
        {
            case nameof(GeneralReport):
                Game.GeneralReports.Add(reportItem);
                break;
            case nameof(FoulReport):
                Game.FoulReports.Add((FoulReport)reportItem);
                break;
            case nameof(TeamChangeReport):
                Game.TeamChangeReports.Add((TeamChangeReport)reportItem);
                break;
            case nameof(SuddenDeathReport):
                Game.SuddenDeathReports.Add((SuddenDeathReport)reportItem);
                break;
            case nameof(ScoreReport):
                Game.ScoreReports.Add((ScoreReport)reportItem);
                break;
            default:
                break;
        }

        OnSave.InvokeAsync(Game);
    }
}
