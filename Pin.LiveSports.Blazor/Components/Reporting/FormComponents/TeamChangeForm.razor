<div class="row">
    <EditForm Model="@ReportItem" OnValidSubmit="e => OnSave.InvokeAsync(ReportItem)" class="form">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <BaseGeneralForm ReportItem="ReportItem"></BaseGeneralForm>

        <div class="row">
            <div class="form-check form-switch" id="selection">
                <label class="form-check-label" for="isOut">Out?</label>
                <InputCheckbox class="form-check-input" id="isOut" @bind-Value="ReportItem.IsOut"></InputCheckbox>
                <ValidationMessage For="(() => ReportItem.IsOut)" />
            </div>
        </div>

        <div class="row">
            <div class="col-3">
                <label class="col-form-label">Team</label>
                <TeamSelect Teams="Teams" OnSelect="SetTeamId"></TeamSelect>
            </div>
            <div class="col-3">
                <label class="col-form-label">Player</label>
                <PlayerSelect Teams="Teams" TeamId="ReportItem.TeamId"  OnSelect="SetPlayerId"></PlayerSelect>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public TeamChangeReport ReportItem { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private void SetTeamId(Guid id)
    {
        ReportItem.TeamId = id;
    }

    private void SetPlayerId(Guid id)
    {
        ReportItem.PlayerId = id;
    }
}
