<div class="row">
    <EditForm Model="@ReportItem" OnValidSubmit="e => OnSave.InvokeAsync(ReportItem)" class="form">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <BaseForm ReportItem="ReportItem"></BaseForm>

        <div class="row">
            <div class="col-3">
                 <label class="col-form-label">Winning team</label>
                 <TeamSelect Teams="Teams" OnSelect="SetWinningTeam"></TeamSelect>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
</div>


@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public WinReport ReportItem { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }


    private void SetWinningTeam(Guid id)
    {
        ReportItem.WinningTeam = Teams.FirstOrDefault(t => t.Id == id);
    }
}
