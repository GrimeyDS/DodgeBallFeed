<EditForm Model="@ReportItem" OnValidSubmit="e => OnSave.InvokeAsync(ReportItem)" class="form">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>

    <BaseForm ReportItem="ReportItem"></BaseForm>

    <div class="row">
        <div class="col-4">
            <label class="col-form-label">Choose player from @Game.HomeTeam.Name</label>
            <PlayerSelect Players="Game.HomeTeam.Players.ToArray()" OnSelect="SetHomePlayerId"></PlayerSelect>
        </div>
    </div>

    <div class="row">
        <div class="col-4">
            <label class="col-form-label">Choose player from @Game.AwayTeam.Name</label>
            <PlayerSelect Players="Game.AwayTeam.Players.ToArray()"  OnSelect="SetAwayPlayerId"></PlayerSelect>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public SuddenDeathReport ReportItem { get; set; }

    [Parameter]
    public Game Game { get; set; }

    private void SetHomePlayerId(Guid id)
    {
        ReportItem.HomePlayer = Game.HomeTeam.Players.FirstOrDefault(p => p.Id == id);
    }

    private void SetAwayPlayerId(Guid id)
    {
        ReportItem.AwayPlayer = Game.AwayTeam.Players.FirstOrDefault(p => p.Id == id);
    }
}
