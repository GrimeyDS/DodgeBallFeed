<div class="row">
    <EditForm Model="@ReportItem" OnValidSubmit="e => OnSave.InvokeAsync(ReportItem)" class="form">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <BaseGeneralForm ReportItem="ReportItem"></BaseGeneralForm>

        <div class="row">
            <div class="col-3">
                <label class="col-form-label">Choose player from @HomeTeam.Name</label>
                <PlayerSelect Team="HomeTeam" TeamId="HomeTeam.Id" OnSelect="SetHomePlayerId"></PlayerSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-3">
                <label class="col-form-label">Choose player from @AwayTeam.Name</label>
                <PlayerSelect Team="AwayTeam" TeamId="AwayTeam.Id" OnSelect="SetAwayPlayerId"></PlayerSelect>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public SuddenDeathReport ReportItem { get; set; }

    [Parameter]
    public Game Game { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Team HomeTeam;
    private Team AwayTeam;

    protected override void OnInitialized()
    {
        HomeTeam = Teams.FirstOrDefault(t => t.Id == Game.HomeTeamId);
        AwayTeam = Teams.FirstOrDefault(t => t.Id == Game.AwayTeamId);
    }

    private void SetHomePlayerId(Guid id)
    {
        ReportItem.HomePlayerId = id;
    }

    private void SetAwayPlayerId(Guid id)
    {
        ReportItem.AwayPlayerId = id;
    }
}
