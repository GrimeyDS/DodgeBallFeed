<div class="game-vs">
    <div class="d-flex align-items-center justify-content-around justify-content-between w-100">
        <div class="team-1 text-center">
            <img src="@homeTeam.LogoUrl" alt="Image">
            <h3>@homeTeam.Name</h3>
            <h4>@Game.HomeScore</h4>
        </div>
        <div>
            <span class="vs"><span>VS</span></span>
        </div>
        <div class="team-2 text-center">
            <img src="@awayTeam.LogoUrl" alt="Image">
            <h3>@awayTeam.Name</h3>
            <h4>@Game.AwayScore</h4>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Game Game { get; set; }


    [Parameter]
    public Team[] Teams { get; set; }

    private Team homeTeam;
    private Team awayTeam;

    protected override void OnInitialized()
    {
        homeTeam = Teams.FirstOrDefault(t => t.Id == Game.HomeTeamId);
        awayTeam = Teams.FirstOrDefault(t => t.Id == Game.AwayTeamId);
    }
}
