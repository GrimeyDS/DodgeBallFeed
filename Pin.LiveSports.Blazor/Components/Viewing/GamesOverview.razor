<div class="row">
    <div class="col">
        @if (currentGame is not null)
        {
            <div> add feed for game)</div>
        }
        else
        {
            <div> select game to see feed</div>
        }
    </div>


    <div class="col-4">
        @foreach (Game game in games)
        {
            <FullGame Teams="Teams" SingleGame="game" OnSelect="SelectGame"></FullGame>
        }
    </div>
</div>
@code {
    [Parameter]
    public List<Game> Games { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Game[] games;

    private Game currentGame;

    protected override void OnInitialized()
    {
        games = Games.ToArray();
    }

    protected override void OnParametersSet()
    {
        games = Games.ToArray();
    }

    private void SelectGame(Game game)
    {
        currentGame = game;
    }
}
