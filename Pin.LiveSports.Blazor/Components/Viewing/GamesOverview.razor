<div class="row">
    <div class="col">
        @if (currentGame is not null)
        {
            <GameFeed Teams="Teams" Game="currentGame"></GameFeed>
        }
        else
        {
            <news></news>
        }
    </div>

    @if (games.Length > 0)
    {
        <div class="col-4" id="allGames">
            @foreach (Game game in games)
            {
                <FullGame Teams="Teams" SingleGame="game" OnSelect="SelectGame"></FullGame>
            }
        </div>
    }

</div>

@code {
    [Parameter]
    public List<Game> Games { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Game[] games;

    private Game currentGame;
    private Player[] players;

    protected override void OnParametersSet()
    {
        games = Games.ToArray();
    }

    private void SelectGame(Game game)
    {
        currentGame = game;
    }
}
