<div class="row">
    <div class="col">
        @if (currentGame is not null)
        {
            @foreach (var report in currentGame.FoulReports)
            {
                    <div>@players.Where(p => p.Id == report.PlayerId).FirstOrDefault().FirstName @players.Where(p => p.Id == report.PlayerId).FirstOrDefault().LastName</div>
            }
            @foreach (var report in currentGame.ScoreReports)
            {
                    <div>@Teams.Where(p => p.Id == report.ScoredTeam).FirstOrDefault().Name </div>
            }
            @foreach (var report in currentGame.SuddenDeathReports)
            {
                    <div>@players.Where(p => p.Id == report.AwayPlayerId).FirstOrDefault().FirstName @players.Where(p => p.Id == report.HomePlayerId).FirstOrDefault().LastName</div>
            }
            @foreach (var report in currentGame.TeamChangeReports)
            {
                    <div>@players.Where(p => p.Id == report.PlayerId).FirstOrDefault().FirstName @players.Where(p => p.Id == report.PlayerId).FirstOrDefault().LastName</div>
            }
            @foreach (var report in currentGame.GeneralReports)
            {
                    <div>@report.ReportMessage</div>
            }

        }
        else
        {
            <div> select game to see feed</div>
        }
    </div>


    <div class="col-4">
        @foreach (Game game in games)
        {
            <FullGame Teams="Teams" SingleGame="game" OnSelect="SelectGame"></FullGame>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<Game> Games { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Game[] games;

    private Game currentGame;
    private Player[] players;

    protected override void OnInitialized()
    {
        players = Teams.SelectMany(t => t.Players).ToArray();
        games = Games.ToArray();
    }

    protected override void OnParametersSet()
    {
        games = Games.ToArray();
    }

    private void SelectGame(Game game)
    {
        currentGame = game;
    }
}
