@inherits Pin.LiveSports.Blazor.Components.Viewing.BaseGameComponent

<div class="container">
    <div class="row">
        <div class="col-lg-12">

            <div class="d-flex team-vs">
                <span class="score">@Game.HomeScore - @Game.AwayScore</span>
                <div class="team-1 w-50">
                    <div class="team-details w-100 text-center">
                        <img src="@Game.HomeTeam.LogoUrl" alt="@Game.HomeTeam.Name" class="img-fluid">
                        <h3>@Game.HomeTeam.Name</h3>

                        <PlayerList Players="@Game.HomeTeam.Players.ToArray()"></PlayerList>


                    </div>
                </div>
                <div class="team-2 w-50">
                    <div class="team-details w-100 text-center">
                        <img src="@Game.AwayTeam.LogoUrl" alt="@Game.AwayTeam.Name" class="img-fluid">
                        <h3>@Game.AwayTeam.Name</h3>

                        <PlayerList Players="@Game.AwayTeam.Players.ToArray()"></PlayerList>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
