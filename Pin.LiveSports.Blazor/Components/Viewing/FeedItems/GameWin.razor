<li class="event" data-date="@(ReportItem.Time)'">
    <h3 class="text-center">@ReportItem.WinningTeam.Name Have Won</h3>

    <div class="text-center">
        <img src="@ReportItem.WinningTeam.LogoUrl" alt="Sudden-Death" />
    </div>

    <div class="text-center">
        @ReportItem.ReportMessage
    </div>
</li>
@code {
    [Parameter]
    public WinReport ReportItem { get; set; }

    [Parameter]
    public Game Game { get; set; }
}
