<li class="event" data-date="@(ReportItem.Time)'">
    <h3 class="text-center">SUDDEN DEATH!</h3>

    <div class="game-vs">
        <div class="d-flex align-items-center justify-content-around justify-content-between w-100">
            <div class="team-1 text-center">
                <h3>@ReportItem.HomePlayer.FirstName @ReportItem.HomePlayer.LastName</h3>
            </div>
            <div>
                <img src="../images/skull.png" alt="Sudden-Death" />
            </div>
            <div class="team-2 text-center">
                <h3>@ReportItem.AwayPlayer.FirstName @ReportItem.AwayPlayer.LastName</h3>
            </div>
        </div>
    </div>

    <div class="text-center">
        @ReportItem.ReportMessage
    </div>
</li>
@code {
    [Parameter]
    public SuddenDeathReport ReportItem { get; set; }

    [Parameter]
    public Game Game { get; set; }
}
