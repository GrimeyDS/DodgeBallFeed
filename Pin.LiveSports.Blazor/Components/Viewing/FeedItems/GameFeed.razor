
<div id="feedContainer">
    <ul class="timeline">
        @foreach (var report in reports)
        {
            var typeName = report.GetType().Name;
            switch (typeName)
            {
                case nameof(GeneralReport):
                    <GeneralReportView ReportItem="report"></GeneralReportView>
                    break;
                case nameof(TeamChangeReport):
                    <TeamChangeReportView ReportItem="(TeamChangeReport)report"></TeamChangeReportView>
                    break;
                case nameof(FoulReport):
                    <FoulReportView ReportItem="(FoulReport)report"></FoulReportView>
                    break;
                case nameof(ScoreReport):
                    <ScoreReportView Game="Game" ReportItem="(ScoreReport)report"></ScoreReportView>
                    break;
                default:
                    break;
            }
        }
    </ul>
</div>




@code {
    [Parameter]
    public Game Game { get; set; }

    private GeneralReport[] reports;

    protected override void OnParametersSet()
    {
        reports = [.. Game.GeneralReports, .. Game.TeamChangeReports, .. Game.SuddenDeathReports, .. Game.ScoreReports, .. Game.FoulReports];
        reports = reports.OrderByDescending(x => x.Time).ToArray();
    }
}
