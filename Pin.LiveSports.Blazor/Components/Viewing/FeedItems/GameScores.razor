<li class="event" data-date="@(ReportItem.Time)'">
    <h3>@ReportItem.ScoredTeam.Name HAVE SCORED!</h3>
    <div>
        @ReportItem.ReportMessage

        <ScoreCard Game="Game"></ScoreCard>
    </div>
</li>
@code {
    [Parameter]
    public ScoreReport ReportItem { get; set; }

    [Parameter]
    public Game Game { get; set; }
}
