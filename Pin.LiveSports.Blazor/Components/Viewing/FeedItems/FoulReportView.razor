<li class="event" data-date="@(ReportItem.Time)'">
    <h3>@ReportItem.Title</h3>

    <div id="foulImgContainer">
        <img id="foul" src="../images/foul.png" alt="foul" />
    </div>

    <div id="foulBody">
        <h2>@player.FirstName @player.LastName</h2>
        @ReportItem.ReportMessage
    </div>
</li>
@code {
    [Parameter]
    public FoulReport ReportItem { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private Player player;
 
    protected override void OnParametersSet()
    {
        player = Teams.SelectMany(t => t.Players).FirstOrDefault(p => p.Id == ReportItem.PlayerId);
    }
}
