
<div id="playerContainer">
    @if (IsCompact)
    {
        foreach (var player in Team.Players)
        {
            if (player.IsOut)
            {
                <div id="playerOut"></div>
            }
            else
            {
                <div id="playerIn"></div>
            }

        }
    }
</div>

@code {
    [Parameter]
    public Team Team { get; set; }

    [Parameter]
    public bool IsCompact { get; set; } = false;
}
