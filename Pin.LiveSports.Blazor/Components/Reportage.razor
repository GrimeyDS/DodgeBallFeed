
<div class="row" id="selection">
    <div>
        <select @bind="selectedType" @onmouseup="ChangeReport" class="form-select" aria-label="Default select example">
            <option value="0">Choose a type of report</option>
            <option value="Report">General report</option>
            <option value="Game">Game report</option>
            <option value="Foul">Foul report</option>
            <option value="TeamChange">Team change report</option>
            <option value="SuddenDeath">Sudden death report</option>
        </select>
    </div>
</div>
<div class="row">
    @if (ReportItem.GetType().Name == nameof(FullGameReport))
    {
        <GameReport Teams="Teams" ReportItem="(FullGameReport)ReportItem" OnSave="e => OnSave.InvokeAsync(ReportItem)"></GameReport>
    }
    else if (ReportItem.GetType().Name == nameof(GeneralReport))
    {
        <div>test</div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<GeneralReport> OnSave { get; set; }

    [Parameter]
    public GeneralReport ReportItem { get; set; }

    [Parameter]
    public Team[] Teams { get; set; }

    private string selectedType = "0";

    protected override void OnInitialized()
    {
        ChangeReport();
    }

    protected override void OnParametersSet()
    {
        ChangeReport();
    }

    private void ChangeReport()
    {
        ReportItem = selectedType switch
        {
            "Report" => new GeneralReport(),
            "Game" => new FullGameReport(),
            "Foul" => new FoulReport(),
            "TeamChange" => new TeamChangeReport(),
            "SuddenDeath" => new SuddenDeathReport(),
            _ => new (),
        };
    }

}
